rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /hasil/{docId} {

      // ==============================
      // SISWA - SIMPAN HASIL UJIAN
      // ==============================
      allow create: if request.auth != null
        && request.auth.token.email == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nama is string
        && request.resource.data.absen is string
        && request.resource.data.sesi is string
        && request.resource.data.nilai is number
        && request.resource.data.benar is number
        && request.resource.data.total is number
        && request.resource.data.waktuSelesai is string;


      // ==============================
      // GURU - MELIHAT HASIL
      // ==============================
      allow read: if request.auth != null
        && request.auth.token.email == "agussant1308@gmail.com";


      // ==============================
      // GURU - MENGUBAH / MENGHAPUS
      // ==============================
      allow update, delete: if request.auth != null
        && request.auth.token.email == "agussant1308@gmail.com";
    }
  }
}
