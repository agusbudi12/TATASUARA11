rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hasil/{docId} {
      allow create: if request.auth != null
        && request.auth.token.email == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nama is string
        && request.resource.data.absen is string
        && request.resource.data.sesi is string
        && request.resource.data.nilai is number
        && request.resource.data.benar is number
        && request.resource.data.total is number
        && request.resource.data.waktuSelesai is string;

      allow read: if request.auth != null
        && request.auth.token.email == "GANTI_EMAIL_GURU";

      allow update, delete: if request.auth != null
        && request.auth.token.email == "GANTI_EMAIL_GURU";
    }
  }
}
